{
  "version": "2.3",
  "loop": {
    "max_iterations": 9999,
    "memory_flush_interval": 3,
    "max_retries_per_subtask": 3,
    "auto_compact_threshold_pct": 80,
    "auto_chain_roadmap": true
  },
  "graph": {
    "max_traversal_depth": 3,
    "context_nodes_limit": 10,
    "auto_backlink": true
  },
  "validation": {
    "enabled": true,
    "test_command": "",
    "lint_command": ""
  },
  "git": {
    "auto_commit": true,
    "commit_on_milestone": true
  }
}
